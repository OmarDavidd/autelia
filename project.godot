; Engine configuration file.
; Godot rewrites this file when the project is opened in the editor.

config_version=5

[application]

config/name="Autelia"
config/description="2D top-down wave survival shooter. Also the experimental environment for a dynamic difficulty adjustment thesis."
run/main_scene="res://modes/survival/survival.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Events="*res://autoload/events.gd"
DebugTools="*res://autoload/debug_tools.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[input]

move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
shoot={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
restart={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
screenshot={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194343)]
}

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="player_bullets"
2d_physics/layer_5="enemy_bullets"

[rendering]

; Compatibility renderer keeps the web export available.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.953, 0.961, 0.945, 1)
